--- game/e2e/m1a.spec.ts ---
1: import { expect, test } from 'playwright/test'
2:
3: // Milestone 1A gate (assembly brief §3.7): wait for the acceptance console
4: // line (budget 30 s), assert PASSED, scrape .badge rows for the report.
5: test('M1A — Floating Origin acceptance', async ({ page }) => {
6:   const consoleLines: string[] = []
7:   page.on('console', (m) => consoleLines.push(`${m.type()}: ${m.text()}`))
8:   page.on('pageerror', (e) => consoleLines.push(`pageerror: ${e.message}`))
9:
10:   // Register the waiter BEFORE goto so an instantly-logging harness is not missed.
11:   const acceptanceLine = page
12:     .waitForEvent('console', {
13:       predicate: (m) => /\[Milestone1A\] acceptance (PASSED|FAILED)/.test(m.text()),
14:       timeout: 30_000,
15:     })
16:     .then((m) => m.text())
17:
18:   await page.goto('/?page=m1a')
19:   const line = await acceptanceLine
20:   console.log(`[m1a gate] acceptance line: ${line}`)
21:
22:   const badges = await page.locator('.badge').allTextContents()
23:   console.log(`[m1a gate] badges: ${JSON.stringify(badges)}`)
24:
25:   console.log('[m1a gate] page console transcript:')
26:   for (const l of consoleLines) console.log(`  ${l}`)
27:
28:   expect(line, 'acceptance console line').toContain('PASSED')
29:   expect(badges.length, 'badge rows scraped').toBeGreaterThan(0)
30:   expect(badges.join(' | '), 'no FAIL badge may remain').not.toContain('FAIL')
31: })

