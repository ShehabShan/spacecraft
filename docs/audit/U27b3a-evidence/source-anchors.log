--- game/playwright.config.ts ---
1: import { defineConfig } from 'playwright/test'
2:
3: // Assembly brief §3.7. Chrome channel is REQUIRED (WebGL2 for 1F's A/B
4: // renders, performance.memory for heap rows, IndexedDB for 1G). Serial
5: // workers: GPU and Web Worker harnesses do not parallelize safely.
6: export default defineConfig({
7:   testDir: 'e2e',
8:   timeout: 300_000,
9:   workers: 1,
10:   use: {
11:     channel: 'chrome',
12:     headless: true,
13:     baseURL: 'http://localhost:4173',
14:   },
15:   webServer: {
16:     command: 'npm run build && npx vite preview --port 4173',
17:     url: 'http://localhost:4173',
18:     reuseExistingServer: false,
19:     timeout: 300_000,
20:   },
21: })
