--- game/e2e/m1c.spec.ts ---
1: import { expect, test } from 'playwright/test'
2:
3: // Milestone 1C gate (§3.7 budget: 150 s — a real 60 s flight window plus
4: // warmup). The harness auto-arms after warmup (~3–6 s) and runs the window;
5: // verdict: `[Milestone1C] acceptance PASSED|FAILED — geo=…`.
6: test('M1C — Web Worker Terrain & Zero-GC Pool acceptance', async ({ page }) => {
7:   const consoleLines: string[] = []
8:   page.on('console', (m) => consoleLines.push(`${m.type()}: ${m.text()}`))
9:   page.on('pageerror', (e) => consoleLines.push(`pageerror: ${e.message}`))
10:
11:   const acceptanceLine = page
12:     .waitForEvent('console', {
13:       predicate: (m) => /\[Milestone1C\] acceptance (PASSED|FAILED)/.test(m.text()),
14:       timeout: 150_000,
15:     })
16:     .then((m) => m.text())
17:
18:   await page.goto('/?page=m1c')
19:   const line = await acceptanceLine
20:   console.log(`[m1c gate] acceptance line: ${line}`)
21:
22:   const badges = await page.locator('.badge').allTextContents()
23:   console.log(`[m1c gate] badges: ${JSON.stringify(badges)}`)
24:   console.log('[m1c gate] page console transcript (tail):')
25:   for (const l of consoleLines.slice(-12)) console.log(`  ${l}`)
26:
27:   expect(line, 'acceptance console line').toContain('PASSED')
28:   expect(badges.length, 'badge rows scraped').toBeGreaterThan(0)
29:   expect(badges.join(' | '), 'no FAIL badge may remain').not.toContain('FAIL')
30: })

